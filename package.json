{
  "name": "ligia-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content": "node scripts/build-content.mjs",
    "predev": "npm run content",
    "dev:sem-login": "vite --mode sem-login --open /aprender",
    "predev:sem-login": "npm run content",
    "prebuild": "npm run content",
    "pretest": "npm run content",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:secrets"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.110.2",
    "jspdf": "^4.2.1",
    "katex": "^0.18.4",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.5.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.186.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^15.15.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "libpg-query": "^17.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  }
